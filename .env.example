# Required: secret used to sign the JWT stored in the auth cookie.
JWT_SECRET=replace-with-a-long-random-secret

# Optional: defaults to mongodb://127.0.0.1:27017/estate
# MONGO_URI=mongodb://127.0.0.1:27017/estate

# Optional: set to "production" to send the auth cookie with the Secure flag.
# NODE_ENV=development
